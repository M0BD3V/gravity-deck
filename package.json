{
  "name": "mob-deck",
  "version": "0.1.1-alpha",
  "description": "Legacy MOB Deck launcher kept for Gravity Deck compatibility and scanner reference",
  "main": "main.js",
  "author": "Mob Studios",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:apk": "npm --prefix mobile-app run build:android",
    "build:release": "node build-release.js",
    "test:scanner": "node test/scanner.test.js",
    "mobile:sync": "npm --prefix mobile-app run sync",
    "mobile:open": "npm --prefix mobile-app run open:android",
    "mobile:build": "npm --prefix mobile-app run build:android",
    "mobile:ios:sync": "npm --prefix mobile-app run sync:ios",
    "mobile:ios:open": "npm --prefix mobile-app run open:ios"
  },
  "build": {
    "appId": "com.mob.mobdeck",
    "productName": "MOB Deck",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "style.css",
      "package.json",
      "src/**/*",
      "mobile/**/*",
      "mobile-app/www/**/*",
      "assets/**/*",
      "capas/**/*",
      "!capas/**/*.exe",
      "!capas/scoped_dir*/**",
      "!dist/**",
      "!node_modules/.cache/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MOB Deck",
      "installerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
